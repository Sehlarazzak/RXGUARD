# Server
PORT=3001

# Database
# Create an empty PostgreSQL database first, e.g.:
#   CREATE DATABASE "RxGuard AI";
# The backend will create tables and seed data automatically on first start.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=RxGuard AI
DB_USER=your_db_username_here
DB_PASSWORD=your_db_password_here

# Auth
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# AI / Semantic Search (optional)
# Local embeddings are generated with Xenova/all-MiniLM-L6-v2 (384 dimensions).
# This threshold controls which medicines are considered semantic candidates.
# The final ranking also requires a verified medical-use overlap, so lowering
# this value mainly helps symptom queries (e.g. "diabetes") find the right
# medicine. Raise it if you see irrelevant candidates.
SEMANTIC_THRESHOLD=0.15
